# ---- XPI BD Intelligence — environment ----
# Copy this file to ".env" and paste your real keys. NEVER commit .env.

# Anthropic (Claude) API key — the brain. Get it at https://console.anthropic.com  -> API Keys
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Which Claude model to use (default is a good balance of quality/cost)
BD_MODEL=claude-sonnet-5

# Web search provider key (Serper.dev — free tier). Get it at https://serper.dev -> API Key
# Leave blank to run website-only (no web search).
SERPER_API_KEY=

# Port the server listens on
PORT=3000
